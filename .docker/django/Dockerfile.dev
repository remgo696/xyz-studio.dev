# =============================================================================
# XYZ Studio - Django Oscar E-commerce
# Dockerfile para Desarrollo Local
# =============================================================================
# Este Dockerfile es más simple que el de producción:
#   - Single stage para desarrollo rápido
#   - Incluye herramientas de debugging
#   - No optimiza para tamaño de imagen
#   - Usa UID/GID del host para evitar problemas de permisos en WSL
# =============================================================================

FROM python:3.13-slim AS development

LABEL maintainer="XYZ Studio <dev@xyz-studio.dev>" \
      environment="development"

# =============================================================================
# ARGs para UID/GID del host (pasados desde docker-compose)
# Por defecto usa 1000:1000 (típico en Linux/WSL)
# =============================================================================
ARG HOST_UID=1000
ARG HOST_GID=1000
ARG APP_USER=devuser
ARG APP_GROUP=devgroup

# Variables de entorno
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    APP_HOME=/app

WORKDIR ${APP_HOME}

# Instalar dependencias del sistema
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libpq-dev \
    libffi-dev \
    git \
    netcat-openbsd \
    curl \
    # Herramientas útiles para debugging
    vim \
    htop \
    # gosu para cambio de usuario en entrypoint
    gosu \
    && rm -rf /var/lib/apt/lists/*

# =============================================================================
# Crear usuario con el mismo UID/GID que el host
# Esto asegura que archivos creados en el contenedor sean del usuario del host
# =============================================================================
RUN groupadd --gid ${HOST_GID} ${APP_GROUP} 2>/dev/null || true && \
    useradd --uid ${HOST_UID} --gid ${HOST_GID} --shell /bin/bash --create-home ${APP_USER} 2>/dev/null || true && \
    # Dar permisos de sudo sin password (útil para debugging)
    echo "${APP_USER} ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Instalar pipenv
RUN pip install --no-cache-dir pipenv

# Copiar archivos de dependencias
COPY Pipfile Pipfile.lock ./

# Instalar dependencias (incluyendo dev)
RUN pipenv install --system --deploy --dev --ignore-pipfile

# Copiar entrypoint de desarrollo
COPY .docker/django/entrypoint.dev.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Crear directorios necesarios con permisos correctos
RUN mkdir -p ${APP_HOME}/staticfiles ${APP_HOME}/media && \
    chown -R ${HOST_UID}:${HOST_GID} ${APP_HOME}

# El código se monta como volumen en desarrollo
WORKDIR ${APP_HOME}

# Guardar UID/GID en variables de entorno para el entrypoint
ENV HOST_UID=${HOST_UID} \
    HOST_GID=${HOST_GID} \
    APP_USER=${APP_USER}

EXPOSE 8000

ENTRYPOINT ["/entrypoint.sh"]
CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]
