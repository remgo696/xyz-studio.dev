# =============================================================================
# XYZ Studio - Docker Environment Variables
# =============================================================================
# Copia este archivo como .env.docker y configura los valores.
# NO COMMITS este archivo con valores reales de producción.
# =============================================================================

# -----------------------------------------------------------------------------
# Django
# -----------------------------------------------------------------------------
SECRET_KEY=your-super-secret-key-change-in-production-min-50-chars
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,xyz-studio.dev

# -----------------------------------------------------------------------------
# Database - PostgreSQL
# -----------------------------------------------------------------------------
# Para desarrollo local con Docker Compose
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=xyz_studio
DATABASE_USER=xyz_user
DATABASE_PASSWORD=xyz_secret_password

# Alternativa: DATABASE_URL (tiene prioridad si se define)
# DATABASE_URL=postgres://xyz_user:xyz_secret_password@db:5432/xyz_studio

# Variables para el contenedor de Postgres
POSTGRES_DB=xyz_studio
POSTGRES_USER=xyz_user
POSTGRES_PASSWORD=xyz_secret_password

# -----------------------------------------------------------------------------
# Solr - Search Engine
# -----------------------------------------------------------------------------
SOLR_URL=http://solr:8983/solr/xyz_core
SOLR_HOST=solr
SOLR_PORT=8983

# -----------------------------------------------------------------------------
# Entrypoint Configuration
# -----------------------------------------------------------------------------
RUN_MIGRATIONS=true
COLLECT_STATIC=true
REBUILD_INDEX=false
CREATE_SUPERUSER=false

# Si CREATE_SUPERUSER=true, define estas variables:
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@xyz-studio.dev
# DJANGO_SUPERUSER_PASSWORD=admin123

# -----------------------------------------------------------------------------
# Gunicorn (Producción)
# -----------------------------------------------------------------------------
WEB_CONCURRENCY=4

# -----------------------------------------------------------------------------
# Email (Opcional)
# -----------------------------------------------------------------------------
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=user@example.com
# EMAIL_HOST_PASSWORD=password
# EMAIL_USE_TLS=True

# -----------------------------------------------------------------------------
# Image Tag (para CI/CD)
# -----------------------------------------------------------------------------
TAG=latest
